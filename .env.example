# API keys for on-the-fly online sample fetching (scripts/fetch_samples_api.py & audio-index MCP)
# Copy this file to .env and fill in your keys: cp .env.example .env

# Freesound API v2 (https://freesound.org/apiv2/apply)
FREESOUND_API_KEY=

# Lots of Sounds API (https://lotsofsounds.com - prefix los_...)
# Note: without key, public demo endpoint /api/v1/sounds/sample (6 CC0 samples) is used as fallback.
LOTSOFSOUNDS_API_KEY=
