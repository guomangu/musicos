# Environnement Python local
.venv/
__pycache__/
*.py[cod]
*$py.class

# Banques de samples locales & index SQLite/NPZ générés
pack/
samples
mcp-servers/audio-index/samples.db*
mcp-servers/audio-index/sample_index.json
mcp-servers/audio-index/sample_index.npz
mcp-servers/audio-index/golden_embeddings.npz
golden_references/*
!golden_references/README.md
!golden_references/external_masters/
!golden_references/external_masters/README.md
!golden_references/spectral_corridors.json
.env
*.wav
*.WAV
*.mp3
.DS_Store
__MACOSX/
*.ogg
*.flac
*.aif
*.aiff
*.zip
*.tar.gz
*.tar.xz
*.7z

# Binaires, modèles lourds et voicebanks téléchargés par install.sh
tools/OpenUtau/
tools/NeuralNote/
tools/models/*.onnx
voicebanks/*
!voicebanks/README.md

# Rendus, stems et fichiers temporaires de session
renders/
projects/*/renders/
projects/*/stems/
projects/*/source/
projects/*/vocals/*.wav
projects/*/midi/*.mid

# Config locale générée dynamiquement par install.sh (chemins absolus machine)
.zed/settings.json
*.bak
*.bak2

# Phase 8 Q4 — masters commerciaux externes (jamais versionnés)
golden_references/external_masters/*/*.wav
golden_references/external_masters/*/*.mp3
golden_references/external_masters/*/*.flac
golden_references/external_masters/*/*.ogg
