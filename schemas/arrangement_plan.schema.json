{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-Studio Declarative Arrangement Plan (Phase 7 P1)",
  "description": "Séparation des données musicales (motifs, sections, modificateurs paramétriques, transitions) et de la compilation Gridline.",
  "type": "object",
  "required": [
    "meta",
    "motifs",
    "sections"
  ],
  "$defs": {
    "noteEvent": {
      "type": "object",
      "required": [
        "start",
        "pitch",
        "velocity"
      ],
      "anyOf": [
        {
          "required": [
            "length"
          ]
        },
        {
          "required": [
            "duration"
          ]
        }
      ],
      "properties": {
        "start": {
          "type": "number",
          "minimum": 0.0
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0.0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0.0
        },
        "pitch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "velocity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 127
        }
      }
    },
    "noteList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/noteEvent"
      }
    },
    "motifObject": {
      "type": "object",
      "required": [
        "notes"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "bars": {
          "type": "integer",
          "minimum": 1
        },
        "loop": {
          "type": "boolean"
        },
        "notes": {
          "$ref": "#/$defs/noteList"
        },
        "compact_notes": {
          "type": "array",
          "description": "v3.0 ultra-compact: [beat, degree_or_pitch, dur_beats, velocity] (degree 0-based from tonic, or absolute MIDI if > 127 flag via 'pitch_mode')",
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4
          }
        },
        "pitch_mode": {
          "type": "string",
          "enum": [
            "degree",
            "midi"
          ],
          "default": "degree"
        }
      }
    },
    "roleModifier": {
      "type": "object",
      "properties": {
        "octave_shift": {
          "type": "integer",
          "minimum": -36,
          "maximum": 36
        },
        "density_scale": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 1.5
        },
        "cutoff_hz": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 20.0,
          "maximum": 20000.0
        },
        "gain_db": {
          "type": "number",
          "minimum": -6.0,
          "maximum": 4.0
        },
        "velocity_scale": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.25
        },
        "motif": {
          "type": "string"
        }
      }
    },
    "filterSweep": {
      "type": "object",
      "required": [
        "role",
        "start_hz",
        "end_hz",
        "bars"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "start_hz": {
          "type": "number",
          "minimum": 20.0,
          "maximum": 20000.0
        },
        "end_hz": {
          "type": "number",
          "minimum": 20.0,
          "maximum": 20000.0
        },
        "bars": {
          "type": "number",
          "exclusiveMinimum": 0.0
        },
        "curve": {
          "type": "string",
          "enum": [
            "exp",
            "linear"
          ]
        }
      }
    },
    "transitionEvent": {
      "type": "object",
      "required": [
        "bar",
        "type"
      ],
      "properties": {
        "bar": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "drum_fill",
            "riser_impact",
            "drum_fill_and_riser",
            "harmonic_anticipation",
            "impact"
          ]
        },
        "style": {
          "type": "string",
          "enum": [
            "auto",
            "snare_roll",
            "tom_fill",
            "pickup"
          ]
        },
        "offset_beats": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 2.0
        },
        "ratio": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    }
  },
  "properties": {
    "version": {
      "type": [
        "integer",
        "string"
      ]
    },
    "meta": {
      "type": "object",
      "required": [
        "bpm",
        "time_signature",
        "key",
        "mode",
        "mix_profile",
        "has_drums"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "genre": {
          "type": "string"
        },
        "bpm": {
          "type": "number",
          "minimum": 40.0,
          "maximum": 300.0
        },
        "time_signature": {
          "type": "object",
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "denominator": {
              "type": "integer",
              "enum": [
                2,
                4,
                8,
                16
              ]
            }
          }
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "mix_profile": {
          "type": "string",
          "enum": [
            "trap_rap",
            "pop_rnb",
            "edm_club",
            "rock_metal",
            "lofi_chill",
            "jazz_acoustic",
            "classical_ambient"
          ]
        },
        "has_drums": {
          "type": "boolean"
        },
        "valence": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "tension": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "energy": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "depth": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "phrase_plan": {
          "type": "string"
        }
      }
    },
    "harmonic_core": {
      "type": "object"
    },
    "channels": {
      "type": [
        "object",
        "array"
      ]
    },
    "motifs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/noteList"
          },
          {
            "$ref": "#/$defs/motifObject"
          },
          {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "$ref": "#/$defs/noteList"
                },
                {
                  "$ref": "#/$defs/motifObject"
                }
              ]
            }
          }
        ]
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "start_bar",
          "bars",
          "active_roles"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "intro",
              "verse",
              "pre_chorus",
              "chorus",
              "bridge",
              "drop",
              "climax",
              "outro"
            ]
          },
          "start_bar": {
            "type": "integer",
            "minimum": 0
          },
          "bars": {
            "type": "integer",
            "minimum": 1
          },
          "comping_style": {
          "type": "string",
          "enum": ["sustained_pad", "broken_arp_up", "broken_arp_pendulum", "rhythmic_comp", "pulse_ostinato", "waltz_bass_chord"],
          "description": "v3.3 #2 OrchestrationEngine : style de comping de la piste chords pour cette section (défaut: arc automatique default_comping_arc)."
        },
        "active_roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "role_modifiers": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/roleModifier"
            }
          },
          "transitions": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "beat4_dropout_bars": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "filter_sweep": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "$ref": "#/$defs/filterSweep"
                      }
                    ]
                  },
                  "outro_fade_bars": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/transitionEvent"
                }
              }
            ]
          }
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transitionEvent"
      }
    },
    "palette_id": {
      "type": "string",
      "description": "v3.0: id de palette propose_palettes a appliquer (blueprint_tracks -> song_blueprint.json via apply_palette_to_blueprint)"
    },
    "core_bars": {
      "type": "integer",
      "minimum": 4,
      "maximum": 16,
      "default": 8
    },
    "phrasing_8bar": {
      "type": "object",
      "description": "v3.2 NarrativeHarmony : phrasé en période 8 mesures Antécédent/Conséquent (demi-cadence mesure 4, cadence fermée mesure 8) + opérateurs motiviques déterministes.",
      "properties": {
        "antecedent_bars": {
          "type": "integer",
          "default": 4,
          "minimum": 2
        },
        "consequent_bars": {
          "type": "integer",
          "default": 4,
          "minimum": 2
        },
        "period_bars": {
          "type": "integer",
          "default": 8,
          "minimum": 4
        },
        "cadence_degree": {
          "type": "integer",
          "default": 1
        },
        "operators": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "motif_answer",
              "rhythmic_lift",
              "call_and_response",
              "melodic_climax_arch"
            ]
          },
          "default": [
            "motif_answer",
            "melodic_climax_arch"
          ]
        }
      }
    }
  }
}